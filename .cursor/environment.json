{
  "name": "checkin",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "user": "ubuntu",
  "install": "python3 -m venv .venv\n.venv/bin/pip install --upgrade pip\n.venv/bin/pip install -e '.[dev]'",
  "start": ".venv/bin/uvicorn checkin.app:app --host 0.0.0.0 --port 8000",
  "ports": [
    {
      "name": "api",
      "port": 8000
    }
  ]
}
