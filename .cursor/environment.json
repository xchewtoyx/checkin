{
  "name": "checkin",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "user": "ubuntu",
  "install": "npm ci",
  "ports": [
    {
      "name": "api",
      "port": 8787
    }
  ],
  "terminals": [
    {
      "name": "dev",
      "command": "npm run dev -- --ip 0.0.0.0",
      "description": "Wrangler local Worker on port 8787"
    }
  ]
}
